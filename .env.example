# Public browser configuration (safe only for the Supabase anonymous key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CHARGEGRID_API_URL=http://localhost:3333
# Google Maps JavaScript API for Admin and Driver PWA maps. Keep the real key only in .env.
VITE_GOOGLE_MAPS_API_KEY=

# Stripe sandbox. Publishable key is safe in the PWA; secret and webhook keys are server-only.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
CHARGEGRID_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Server-only configuration. Never expose the service role key to a frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=3333

# Future external AI service. The baseline does not call it.
AI_API_URL=
